---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShareView from '../components/forms/ShareView.tsx';
import App from '../components/App.tsx';
---

<BaseLayout title="ASJ - Candidate Viewer" description="View candidates for ASJ job">
  <App client:load />
  <a href="/" class="fixed top-4 left-4 z-[100] flex items-center gap-2 px-4 py-2 bg-black/70 hover:bg-black/90 text-white text-xs font-bold rounded-full border border-white/20 backdrop-blur-sm transition-all shadow-lg hover:scale-105">
    <i class="fas fa-arrow-left"></i> <span class="hidden sm:inline">Portal</span>
  </a>
  <ShareView client:load />
</BaseLayout>
