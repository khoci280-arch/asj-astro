---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiswaBaruForm from '../components/forms/SiswaBaruForm.tsx';
import App from '../components/App.tsx';
import Toast from '../components/Toast.tsx';
import FormToolbar from "../components/forms/FormToolbar";
---

<BaseLayout title="ASJ - Pendaftaran Siswa (AI Assistant)" description="Form pendaftaran siswa baru LPK ASJ dengan AI Assistant Qween Jeklin">
  <App showHeader={false} client:only="preact" />
  <Toast client:only="preact" />

  

  <FormToolbar client:only="preact" titleKey="toolbar.siswa" />
  <SiswaBaruForm client:only="preact" />
</BaseLayout>
