---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';

export interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = 'PT Amanah Sakura Japan — Job Portal', lang = 'id' } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#020617" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="ASJ Portal" />
  <meta name="referrer" content="no-referrer" />
  <base target="_top" />
  
  <link rel="icon" type="image/png" href="https://gdwvffmevwtwnzrapjwy.supabase.co/storage/v1/object/public/asj-files/assets/logo-removebg-preview.webp" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="https://fonts.gstatic.com/s/montserrat/v29/JTUHjIg1_i6t8kCHKm4532VJOt5-QNFgpCtr6Ew-Y3tcoqK5.woff2" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&display=swap" rel="stylesheet" />
  
  <style is:global>
    @import '../styles/global.css';
  </style>
</head>
<body id="asj-body" class="bg-slate-950 text-slate-100 min-h-screen transition-colors duration-500 flow-root">
  <Header />
  
  <main id="asj-main" class="max-w-7xl mx-auto px-4">
    <slot />
  </main>
  
  <Footer />
  <BottomNav />
  
  <script>
    // ─── Fase 3: Auth restore ───
    (function initAuth() {
      try {
        const adminLogin = localStorage.getItem('asj_admin_login');
        const adminName = localStorage.getItem('asj_admin_name');
        if (adminLogin === 'sukses' && adminName) {
          const navMode = document.getElementById('nav-mode');
          const navAdmin = document.getElementById('nav-admin-mode');
          if (navMode) navMode.classList.add('hidden');
          if (navAdmin) navAdmin.classList.remove('hidden');
        }
        const kandidatLogin = localStorage.getItem('asj_kandidat_login');
        const kandidatName = localStorage.getItem('asj_kandidat_name');
        if (kandidatLogin === 'sukses' && kandidatName) {
          const navMode = document.getElementById('nav-mode');
          const navKandidat = document.getElementById('nav-kandidat-mode');
          const namaEl = document.getElementById('nama-kandidat-login');
          if (navMode) navMode.classList.add('hidden');
          if (navKandidat) navKandidat.classList.remove('hidden');
          if (namaEl) namaEl.textContent = kandidatName;
        }
      } catch (e) { console.warn('[Auth] Restore failed:', e); }
    })();

    // ─── Fase 5: Service Worker + Auto-Reload ───
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').then((reg) => {
        // Check for SW updates every 5 minutes
        setInterval(() => {
          reg.update().catch(() => {});
        }, 5 * 60 * 1000);
      }).catch(() => {});
      
      // Listen for ASJ_FORCE_RELOAD from SW
      navigator.serviceWorker.addEventListener('message', (e) => {
        if (e.data?.type === 'ASJ_FORCE_RELOAD') {
          console.log('[SW] New version detected — reloading...');
          window.location.reload();
        }
      });
    }
  </script>
</body>
</html>
