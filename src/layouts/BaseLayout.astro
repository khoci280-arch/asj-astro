---
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.tsx';

export interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = 'PT Amanah Sakura Japan — Job Portal', lang = 'id' } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#020617" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="ASJ Portal" />
  <meta name="referrer" content="no-referrer" />
  <base target="_top" />
  
  <link rel="icon" type="image/png" href="https://gdwvffmevwtwnzrapjwy.supabase.co/storage/v1/object/public/asj-files/assets/logo-removebg-preview.webp" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Montserrat preloaded via Google Fonts stylesheet below -->
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&display=swap" rel="stylesheet" />
  
  <style is:global>
    @import '../styles/global.css';
  </style>
<script>
    // Restore theme from localStorage
    (function(){
      var t = localStorage.getItem("asjTheme");
      if (t === "light") document.documentElement.classList.add("light");
    })();
  </script>
</head>
<body id="asj-body" class="bg-slate-950 text-slate-100 min-h-screen transition-colors duration-500 flow-root">
  <div id="global-loader" style="display: none !important;">
    <i class="fas fa-spinner fa-spin text-5xl text-pink-500 mb-4"></i>
    <h2 class="text-xl font-bold tracking-widest text-slate-200">MEMUAT ASJ OS V7...</h2>
    <p id="loader-msg" class="text-sm text-slate-500 mt-2 mb-6">Mempersiapkan UI Modern</p>
    <button onclick="document.getElementById(&quot;global-loader&quot;).style.display=&quot;none&quot;" class="px-6 py-2.5 bg-red-600 hover:bg-red-500 border border-red-500 rounded-full text-sm font-bold text-white transition-colors shadow-lg"><i class="fas fa-times mr-1"></i> Tutup Paksa Loading</button>
  </div>
  <div id="sakura-particles" class="fixed inset-0 overflow-hidden hidden" aria-hidden="true"></div>
  <a href="#main-content" class="skip-link">Lewati ke konten utama</a>
  
    <slot />
  
  <Footer />
  <BottomNav client:only="preact" />
  
  <script>
    // ─── Fase 3 (Reactive): Auth restore via authReactive.ts ───
    // Nanostores handles cross-tab sync + session expiry automatically.
    // This script only does DOM manipulation for Astro static elements
    // (Header nav modes) that aren't Preact components yet.
    // ─── Auth managed by Nanostores (authReactive.ts) ───
    // ─── Fase 5: Service Worker + Auto-Reload ───
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').then((reg) => {
        setInterval(() => { reg.update().catch(() => {}); }, 5 * 60 * 1000);
      }).catch(() => {});
      navigator.serviceWorker.addEventListener('message', (e) => {
        if (e.data?.type === 'ASJ_FORCE_RELOAD') {
          console.log('[SW] New version — reloading...');
          window.location.reload();
        }
      });
    }
  </script>
<script>
  // i18n: listen for language changes and translate [data-lang] elements
  window.addEventListener("asj-lang-change", function() {
    // translateDataLang() is called by App.tsx after Nanostores update
  });
  window.addEventListener("storage", function(e) {
    if (e.key === "asj_lang") {
      // Cross-tab: trigger translation on next tick after localStorage updates
      setTimeout(function() { window.dispatchEvent(new Event("asj-lang-change")); }, 100);
    }
  });
</script>
</body>
</html>
