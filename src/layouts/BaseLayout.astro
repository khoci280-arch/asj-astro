---
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';

export interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = 'PT Amanah Sakura Japan — Job Portal', lang = 'id' } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#020617" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="ASJ Portal" />
  <meta name="referrer" content="no-referrer" />
  <base target="_top" />
  
  <link rel="icon" type="image/png" href="https://gdwvffmevwtwnzrapjwy.supabase.co/storage/v1/object/public/asj-files/assets/logo-removebg-preview.webp" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Montserrat preloaded via Google Fonts stylesheet below -->
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&display=swap" rel="stylesheet" />
  
  <style is:global>
    @import '../styles/global.css';
  </style>
</head>
<body id="asj-body" class="bg-slate-950 text-slate-100 min-h-screen transition-colors duration-500 flow-root">
  <a href="#main-content" class="skip-link">Lewati ke konten utama</a>
  
  <slot />
<div id="global-announcement" class="hidden max-w-7xl mx-auto px-4 mt-6">
  <div class="bg-rose-700 rounded-2xl p-2.5 flex items-center shadow-[0_0_20px_rgba(225,29,72,0.3)] border border-rose-500/60 relative overflow-hidden">
    <div class="absolute left-0 top-0 bottom-0 bg-red-800 w-12 flex items-center justify-center z-10 rounded-l-2xl border-r border-red-600/60 shadow-md">
      <i class="fas fa-bullhorn text-white animate-bounce text-lg"></i>
    </div>
    <div class="ml-12 mr-2 overflow-hidden"><div id="marquee-text" class="text-white text-sm font-bold tracking-wide whitespace-nowrap animate-[marquee-scroll_20s_linear_infinite]"></div></div>
  </div>
</div>
<script>
  fetch("/.netlify/functions/getAppData", { method: "POST", headers: {"Content-Type":"application/json"}, body: JSON.stringify({action:"getAppData",args:["admin"]}) }).then(r=>r.json()).then(d=>{ if(d.success && d.pengumuman){ var el=document.getElementById("marquee-text"); if(el){el.textContent=d.pengumuman; document.getElementById("global-announcement").classList.remove("hidden");}} }).catch(()=>{});
</script>
  
  <Footer />
  <BottomNav />
  
  <script>
    // ─── Fase 3 (Reactive): Auth restore via authReactive.ts ───
    // Nanostores handles cross-tab sync + session expiry automatically.
    // This script only does DOM manipulation for Astro static elements
    // (Header nav modes) that aren't Preact components yet.
    // ─── Auth managed by Nanostores (authReactive.ts) ───
    // ─── Fase 5: Service Worker + Auto-Reload ───
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').then((reg) => {
        setInterval(() => { reg.update().catch(() => {}); }, 5 * 60 * 1000);
      }).catch(() => {});
      navigator.serviceWorker.addEventListener('message', (e) => {
        if (e.data?.type === 'ASJ_FORCE_RELOAD') {
          console.log('[SW] New version — reloading...');
          window.location.reload();
        }
      });
    }
  </script>
</body>
</html>
