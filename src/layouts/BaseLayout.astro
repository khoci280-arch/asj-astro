---
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';

export interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = 'PT Amanah Sakura Japan — Job Portal', lang = 'id' } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#020617" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="ASJ Portal" />
  <meta name="referrer" content="no-referrer" />
  <base target="_top" />
  
  <link rel="icon" type="image/png" href="https://gdwvffmevwtwnzrapjwy.supabase.co/storage/v1/object/public/asj-files/assets/logo-removebg-preview.webp" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Montserrat preloaded via Google Fonts stylesheet below -->
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&display=swap" rel="stylesheet" />
  
  <style is:global>
    @import '../styles/global.css';
  </style>
</head>
<body id="asj-body" class="bg-slate-950 text-slate-100 min-h-screen transition-colors duration-500 flow-root">
  
  <main id="asj-main" class="max-w-7xl mx-auto px-4">
    <slot />
  </main>
  
  <Footer />
  <BottomNav />
  
  <script>
    // ─── Fase 3 (Reactive): Auth restore via authReactive.ts ───
    // Nanostores handles cross-tab sync + session expiry automatically.
    // This script only does DOM manipulation for Astro static elements
    // (Header nav modes) that aren't Preact components yet.
    (function initAuth() {
      try {
        const adminLogin = localStorage.getItem('asj_admin_login');
        const adminName = localStorage.getItem('asj_admin_name');
        const adminTs = localStorage.getItem('asj_admin_ts');
        const SESSION_MAX_AGE = 24 * 60 * 60 * 1000;
        
        if (adminLogin === 'sukses' && adminName) {
          const ts = adminTs ? parseInt(adminTs) : 0;
          if (Date.now() - ts < SESSION_MAX_AGE) {
            const navMode = document.getElementById('nav-mode');
            const navAdmin = document.getElementById('nav-admin-mode');
            if (navMode) navMode.classList.add('hidden');
            if (navAdmin) navAdmin.classList.remove('hidden');
          } else {
            // Session expired → clear
            localStorage.removeItem('asj_admin_login');
            localStorage.removeItem('asj_admin_name');
            localStorage.removeItem('asj_admin_session');
            localStorage.removeItem('asj_admin_ts');
          }
        }
        
        const kanLogin = localStorage.getItem('asj_kandidat_login');
        const kanName = localStorage.getItem('asj_kandidat_name');
        const kanTs = localStorage.getItem('asj_kandidat_ts');
        
        if (kanLogin === 'sukses' && kanName) {
          const ts = kanTs ? parseInt(kanTs) : 0;
          if (Date.now() - ts < SESSION_MAX_AGE) {
            const navMode = document.getElementById('nav-mode');
            const navKandidat = document.getElementById('nav-kandidat-mode');
            const namaEl = document.getElementById('nama-kandidat-login');
            if (navMode) navMode.classList.add('hidden');
            if (navKandidat) navKandidat.classList.remove('hidden');
            if (namaEl) namaEl.textContent = kanName;
          } else {
            localStorage.removeItem('asj_kandidat_login');
            localStorage.removeItem('asj_kandidat_name');
            localStorage.removeItem('asj_kandidat_wa');
            localStorage.removeItem('asj_kandidat_session');
            localStorage.removeItem('asj_kandidat_ts');
          }
        }
      } catch (e) { console.warn('[Auth] Restore failed:', e); }
    })();

    // ─── Fase 5: Service Worker + Auto-Reload ───
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').then((reg) => {
        setInterval(() => { reg.update().catch(() => {}); }, 5 * 60 * 1000);
      }).catch(() => {});
      navigator.serviceWorker.addEventListener('message', (e) => {
        if (e.data?.type === 'ASJ_FORCE_RELOAD') {
          console.log('[SW] New version — reloading...');
          window.location.reload();
        }
      });
    }
  </script>
</body>
</html>
